# ─────────────────────────────────────────────────────────────
# Mise — variables de entorno
# Copia este fichero a `.env.local` y rellena los valores.
# NUNCA commitees `.env.local`.
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio. SOLO en servidor (alta de usuarios, cron de recordatorios).
# Salta RLS: no la expongas nunca al cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cadena de conexión Postgres para Prisma (Supabase → Database → Connection string)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Notificaciones push PWA (MISE-004). Genera el par con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operador@ejemplo.com

# Secreto que protege /api/cron/recordatorios. Vercel Cron lo manda como
# `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# URL pública del despliegue (para los deep links de las notificaciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000
