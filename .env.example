# ─────────────────────────────────────────────────────────────
# Ergobox — variables de entorno
# Copia este fichero a `.env.local` y rellena los valores.
# NUNCA commitees `.env.local`.
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Clave de servicio. SOLO en servidor, y solo en dos sitios: el alta de usuarios
# de /admin y el cron de avisos. Salta RLS entera: no la expongas nunca al cliente
# ni con prefijo NEXT_PUBLIC_.
#
# Las URL de las fotos NO se firman con esta clave, sino con la sesión de quien
# mira, para que la decisión de si puede verlas la tome la política del bucket.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Cadena de conexión Postgres para Prisma (Supabase → Database → Connection string)
DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Notificaciones push PWA. Genera el par con:
#   npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hola@ergobox.es

# Secreto que protegerá el cron de avisos de revisión (fase 5). Vercel Cron lo
# manda como `Authorization: Bearer <CRON_SECRET>`.
CRON_SECRET=cambia-esto-por-una-cadena-larga-aleatoria

# URL pública del despliegue (para los deep links de las notificaciones)
NEXT_PUBLIC_APP_URL=http://localhost:3000
