// ─────────────────────────────────────────────────────────────────────────────
// Ergobox v1 — modelo de datos
//
// NOTA IMPORTANTE SOBRE EL FLUJO DE MIGRACIONES
// Las migraciones son SQL-first: viven en `supabase/migrations/` y son la fuente
// de verdad. La razón es que la mitad del comportamiento de Ergobox (políticas
// RLS, triggers de semáforo e histórico, vistas con security_invoker, políticas
// de storage) no se puede expresar en el schema de Prisma, y tener dos fuentes de
// verdad parciales es peor que tener una completa.
//
// Este fichero es el espejo tipado de ese SQL. Sirve para `prisma studio`,
// `prisma db pull` y para scripts con tipos. No ejecutes `prisma migrate dev`
// contra este proyecto: borraría las políticas.
// ─────────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum rol_usuario {
  admin
  tecnico
  cliente
}

enum tipo_maquina {
  rowerg
  skierg
  bikeerg
  air_bike
  cinta
  barra
  disco
  rack
  otro
}

enum semaforo {
  verde
  ambar
  rojo
  sin_revisar
}

enum estado_servicio {
  planificado
  en_curso
  hecho
  cancelado
}

enum momento_foto {
  antes
  despues
}

enum tipo_evento {
  alta
  servicio
  cambio_estado
  incidencia
  baja
}

model clientes {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nombre            String
  direccion         String?
  poblacion         String?
  contacto_nombre   String?
  contacto_telefono String?
  contacto_email    String?
  notas             String?
  activo            Boolean  @default(true)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)

  perfiles  perfiles[]
  maquinas  maquinas[]
  servicios servicios[]
}

model perfiles {
  id         String      @id @db.Uuid
  nombre     String      @default("")
  rol        rol_usuario @default(cliente)
  cliente_id String?     @db.Uuid
  activo     Boolean     @default(true)
  created_at DateTime    @default(now()) @db.Timestamptz(6)

  cliente             clientes?            @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  servicios_tecnico   servicios[]          @relation("tecnico")
  servicios_creados   servicios[]          @relation("creador")
  fotos_subidas       fotos[]
  eventos             eventos_maquina[]
  push_subscriptions  push_subscriptions[]
  avisos              aviso_log[]

  @@index([cliente_id])
}

model maquinas {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id       String       @db.Uuid
  nombre           String
  tipo             tipo_maquina @default(otro)
  marca            String?
  modelo           String?
  num_serie        String?
  ubicacion        String?
  estado           semaforo     @default(sin_revisar)
  cadencia_meses   Int?         @db.SmallInt
  ultima_revision  DateTime?    @db.Date
  proxima_revision DateTime?    @db.Date
  notas            String?
  activa           Boolean      @default(true)
  created_at       DateTime     @default(now()) @db.Timestamptz(6)
  updated_at       DateTime     @default(now()) @db.Timestamptz(6)

  cliente clientes          @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  partes  partes[]
  eventos eventos_maquina[]
  avisos  aviso_log[]

  @@index([cliente_id])
  @@index([proxima_revision])
}

model servicios {
  id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id String          @db.Uuid
  fecha      DateTime        @db.Date
  estado     estado_servicio @default(planificado)
  tecnico_id String?         @db.Uuid
  notas      String?
  cerrado_at DateTime?       @db.Timestamptz(6)
  created_by String?         @db.Uuid
  created_at DateTime        @default(now()) @db.Timestamptz(6)
  updated_at DateTime        @default(now()) @db.Timestamptz(6)

  cliente clientes  @relation(fields: [cliente_id], references: [id], onDelete: Cascade)
  tecnico perfiles? @relation("tecnico", fields: [tecnico_id], references: [id])
  creador perfiles? @relation("creador", fields: [created_by], references: [id])
  partes  partes[]

  @@index([cliente_id, fecha])
}

model partes {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  servicio_id      String    @db.Uuid
  maquina_id       String    @db.Uuid
  trabajo_previsto String?
  trabajo_hecho    String?
  piezas           String?
  estado_antes     semaforo?
  estado_despues   semaforo?
  damper           Int?      @db.SmallInt
  drag_factor      Int?      @db.SmallInt
  minutos          Int?      @db.SmallInt
  importe          Decimal?  @db.Decimal(10, 2)
  hecho            Boolean   @default(false)
  client_ref       String?   @unique
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @db.Timestamptz(6)

  servicio servicios         @relation(fields: [servicio_id], references: [id], onDelete: Cascade)
  maquina  maquinas          @relation(fields: [maquina_id], references: [id])
  fotos    fotos[]
  eventos  eventos_maquina[]

  @@unique([servicio_id, maquina_id])
  @@index([maquina_id])
}

model fotos {
  id         String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  parte_id   String       @db.Uuid
  momento    momento_foto
  ruta       String       @unique
  orden      Int          @default(0) @db.SmallInt
  bytes      Int?
  subida_por String?      @db.Uuid
  created_at DateTime     @default(now()) @db.Timestamptz(6)

  parte  partes    @relation(fields: [parte_id], references: [id], onDelete: Cascade)
  subida perfiles? @relation(fields: [subida_por], references: [id])

  @@index([parte_id, momento, orden])
}

model eventos_maquina {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maquina_id        String      @db.Uuid
  fecha             DateTime    @db.Date
  tipo              tipo_evento
  texto             String      @default("")
  estado_resultante semaforo?
  parte_id          String?     @db.Uuid
  autor_id          String?     @db.Uuid
  created_at        DateTime    @default(now()) @db.Timestamptz(6)

  maquina maquinas  @relation(fields: [maquina_id], references: [id], onDelete: Cascade)
  parte   partes?   @relation(fields: [parte_id], references: [id])
  autor   perfiles? @relation(fields: [autor_id], references: [id])

  @@index([maquina_id, fecha])
}

model push_subscriptions {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  perfil_id  String   @db.Uuid
  endpoint   String   @unique
  p256dh     String
  auth       String
  created_at DateTime @default(now()) @db.Timestamptz(6)

  perfil perfiles @relation(fields: [perfil_id], references: [id], onDelete: Cascade)
}

model aviso_log {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  maquina_id String   @db.Uuid
  perfil_id  String   @db.Uuid
  enviado_el DateTime @db.Date
  enviado_at DateTime @default(now()) @db.Timestamptz(6)

  maquina maquinas @relation(fields: [maquina_id], references: [id], onDelete: Cascade)
  perfil  perfiles @relation(fields: [perfil_id], references: [id], onDelete: Cascade)

  @@unique([maquina_id, perfil_id, enviado_el])
}

model ajustes {
  clave      String   @id
  valor      Json
  updated_at DateTime @default(now()) @db.Timestamptz(6)
}
